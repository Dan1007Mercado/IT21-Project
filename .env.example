APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

INTSEC_TRUSTED_PROXIES=
INTSEC_IP_ENRICHMENT_ENABLED=false
INTSEC_IP_ENRICHMENT_CACHE_HOURS=168
INTSEC_REQUEST_WINDOW_SECONDS=60
INTSEC_REPEATED_REQUEST_THRESHOLD=60
INTSEC_REQUEST_SPIKE_THRESHOLD=250
INTSEC_REPEATED_404_THRESHOLD=8
INTSEC_REPEATED_403_THRESHOLD=6
INTSEC_REPEATED_401_THRESHOLD=6
INTSEC_SENSITIVE_PATH_PROBE_THRESHOLD=2
INTSEC_BRUTE_FORCE_THRESHOLD=5
INTSEC_PASSWORD_SPRAY_THRESHOLD=5
INTSEC_DISTRIBUTED_ATTACK_THRESHOLD=3
INTSEC_CORRELATION_WINDOW_MINUTES=30
INTSEC_ALERT_COOLDOWN_MINUTES=15

# Server-to-server event intake. Generate a long random value locally; never commit it.
INTSEC_API_TOKEN=
INTSEC_EVENT_SOURCES=hotel-booking

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
# Local default: broadcast immediately, but only after a successful DB commit.
# Production: set this to database and supervise `php artisan queue:work`.
INTSEC_REALTIME_QUEUE_CONNECTION=sync
REVERB_APP_ID=intsec-local
REVERB_APP_KEY=intsec-local-key
REVERB_APP_SECRET=change-this-reverb-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Bind address belongs to the Reverb server; REVERB_HOST is browser/server visible.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
